{
  "title": "Workout onboarding",
  "fields": {
    "goal": {
      "label": "Goal",
      "type": "select",
      "options": [
        "Build strength",
        "Build muscle",
        "Improve general fitness"
      ],
      "required": true,
      "default": null
    },
    "equipment": {
      "label": "Equipment",
      "type": "select",
      "options": [
        "Bodyweight only",
        "Bodyweight and dumbbells"
      ],
      "required": true,
      "default": null
    },
    "workouts_per_week": {
      "label": "Workouts per week",
      "help": "Choose how many workouts you want each week.",
      "type": "select",
      "options": [
        1,
        2,
        3,
        4
      ],
      "required": true,
      "default": null
    },
    "session_length_minutes": {
      "label": "Session length (minutes)",
      "help": "Choose an approximate session length.",
      "type": "select",
      "options": [
        30,
        45,
        60
      ],
      "required": true,
      "default": null
    }
  }
}